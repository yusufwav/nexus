# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @type=string(minLength=1)
GOOGLE_GENERATIVE_AI_API_KEY=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=32) @sensitive
# Seals reader-supplied provider API keys (AES-256-GCM) so a database
# dump is not a credential dump. Deliberately NOT derived from
# BETTER_AUTH_SECRET: that one is meant to be rotatable, and coupling
# them means rotating it silently breaks every stored key. Rotating THIS
# invalidates stored keys too — re-enter them afterwards.
PROVIDER_KEYS_SECRET=
